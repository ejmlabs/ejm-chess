{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ejm-chess-capacity-unsealed",
  "main": "src/server/capacity-qualification.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "CapacityGame" },
      { "name": "COMPETITION", "class_name": "CapacityCompetition" },
      { "name": "CAPACITY_RUN", "class_name": "CapacityRun" }
    ]
  },
  "migrations": [{
    "tag": "capacity-v1",
    "new_sqlite_classes": ["CapacityGame", "CapacityCompetition", "CapacityRun"]
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ejm-chess-capacity-unsealed",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 50 }
}
