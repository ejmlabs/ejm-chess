{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ejm-chess-timeout-proofs",
  "account_id": "00000000000000000000000000000000",
  "main": "src/server/proof-service.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "limits": { "cpu_ms": 100 },
  "durable_objects": {
    "bindings": [
      { "name": "PROVER", "class_name": "TimeoutProver" }
    ]
  },
  "migrations": [{
    "tag": "proof-service-v1",
    "new_sqlite_classes": ["TimeoutProver"]
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ejm-chess",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "TIMEOUT_PROOF_PROFILE": "off",
    "MONTHLY_PROOF_LIMIT": "0",
    "NEW_WORK_STOPPED": "true",
    "RANKED_ENABLED": "false",
    "TOURNAMENTS_ENABLED": "false",
    "ARENAS_ENABLED": "false",
    "ANALYSIS_ENABLED": "false",
    "AI_ENABLED": "false"
  }
}
