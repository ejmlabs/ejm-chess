{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ejm-chess-proof-qualification-unarmed",
  "account_id": "00000000000000000000000000000000",
  "main": "src/server/proof-qualification.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "limits": { "cpu_ms": 50 },
  "durable_objects": {
    "bindings": [
      { "name": "PROOF_QUALIFICATION", "class_name": "ProofQualification" },
      { "name": "PROVER", "class_name": "QualificationTimeoutProver" }
    ]
  },
  "migrations": [{
    "tag": "proof-qualification-v1",
    "new_sqlite_classes": ["ProofQualification", "QualificationTimeoutProver"]
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ejm-chess-proof-qualification-unarmed",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "TIMEOUT_PROOF_PROFILE": "off",
    "MONTHLY_PROOF_LIMIT": "0",
    "NEW_WORK_STOPPED": "true",
    "RANKED_ENABLED": "false",
    "TOURNAMENTS_ENABLED": "false",
    "ARENAS_ENABLED": "false",
    "ANALYSIS_ENABLED": "false",
    "AI_ENABLED": "false",
    "PROOF_QUALIFICATION_SCOPE": "ejm-chess-proof-qualification-replace-me",
    "PROOF_QUALIFICATION_DATABASE_ID": "00000000-0000-0000-0000-000000000000",
    "PROOF_QUALIFICATION_CONTROL_NAMESPACE_ID": "00000000000000000000000000000000",
    "PROOF_QUALIFICATION_PROVER_NAMESPACE_ID": "11111111111111111111111111111111",
    "PROOF_QUALIFICATION_SOURCE_REVISION": "0000000000000000000000000000000000000000",
    "PROOF_QUALIFICATION_EXPIRES_AT": "0",
    "PROOF_QUALIFICATION_TIER": "unset"
  }
}
