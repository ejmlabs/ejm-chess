{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ejm-chess-recovery-drill",
  "account_id": "00000000000000000000000000000000",
  "main": "src/server/recovery-drill.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // scripts/recovery-drill.mjs reaches this Worker only at its own workers.dev host. Set false and redeploy when the drill ends.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "limits": { "cpu_ms": 50 },
  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "RecoveryDrillGame" },
      { "name": "COMPETITION", "class_name": "RecoveryDrillCompetition" }
    ]
  },
  "migrations": [{
    "tag": "recovery-drill-v1",
    "new_sqlite_classes": ["RecoveryDrillGame", "RecoveryDrillCompetition"]
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ejm-chess-recovery-drill",
    "database_id": "11111111-1111-1111-1111-111111111111",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "AUTH_BASE_URL": "https://chess.ejmlabs.com",
    "LOCAL_DEV": "false",
    "OPERATION_MODE": "unattended",
    "GAME_RETIREMENT_MODE": "preview",
    "AI_ENABLED": "false",
    "RANKED_ENABLED": "false",
    "TOURNAMENTS_ENABLED": "false",
    "ARENAS_ENABLED": "false",
    "NEW_WORK_STOPPED": "true",
    "PRODUCTION_RESOURCE_IDS": "99999999-9999-9999-9999-999999999999",
    "RECOVERY_DRILL_SCOPE": "ejm-chess-recovery-drill-replace-me",
    "RECOVERY_DATABASE_ID": "11111111-1111-1111-1111-111111111111",
    "RECOVERY_GAME_NAMESPACE_ID": "11111111111111111111111111111111",
    "RECOVERY_COMPETITION_NAMESPACE_ID": "22222222222222222222222222222222",
    "RECOVERY_SOURCE_REVISION": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  }
}
